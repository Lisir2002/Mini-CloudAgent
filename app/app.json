{
  "expo": {
    "name": "Mini CloudAgent",
    "slug": "mini-cloudagent",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minicloudagent.app"
    },
    "android": {
      "package": "com.minicloudagent.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
